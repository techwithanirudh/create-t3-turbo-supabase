{
  "name": "create-turbo-stack",
  "private": true,
  "engines": {
    "node": ">=20.12.0"
  },
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "db:studio": "turbo -F @acme/db studio",
    "db:check": "turbo -F @acme/db check",
    "db:migration:generate": "turbo -F @acme/db migration:generate",
    "db:migration:generate:custom": "turbo -F @acme/db migration:generate:custom",
    "db:migrate:local": "turbo -F @acme/db migrate:local",
    "db:migrate:prod": "turbo -F @acme/db migrate:prod",
    "dev": "turbo watch dev",
    "dev:next": "turbo watch dev -F @acme/nextjs...",
    "format": "turbo run format --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
    "lint": "turbo run lint --continue -- --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location node_modules/.cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "postinstall": "pnpm lint:ws",
    "typecheck": "turbo run typecheck",
    "ui-add": "turbo run ui-add",
    "prepare": "husky",
    "pre-commit": "./scripts/pre-commit.sh",
    "logs": "./scripts/pre-commit.sh --logs"
  },
  "devDependencies": {
    "@acme/prettier-config": "workspace:*",
    "@turbo/gen": "^2.0.6",
    "dotenv": "^16.4.7",
    "husky": "^9.1.7",
    "prettier": "^3.3.2",
    "tsx": "^4.19.3",
    "turbo": "^2.0.6",
    "typescript": "^5.5.3"
  },
  "prettier": "@acme/prettier-config"
}
