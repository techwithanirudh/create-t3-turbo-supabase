{
  "name": "@acme/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "pnpm with-env npx supabase start",
    "clean": "rm -rf .turbo node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "studio": "pnpm with-env drizzle-kit studio",
    "check": "pnpm with-env drizzle-kit check",
    "migration:generate": "pnpm with-env drizzle-kit generate",
    "migration:generate:custom": "pnpm with-env drizzle-kit generate --custom --name=",
    "migrate:local": "pnpm with-env tsx src/migrate.ts",
    "migrate:prod": "dotenv -e ../../.env.production -- tsx src/migrate.ts",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "with-env": "dotenv -e ../../.env.local --"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.10.1",
    "@vercel/postgres": "^0.9.0",
    "drizzle-orm": "^0.31.2",
    "drizzle-zod": "^0.5.1",
    "pg": "^8.11.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@types/pg": "^8.10.9",
    "dotenv-cli": "^7.4.2",
    "drizzle-kit": "^0.22.8",
    "eslint": "^9.6.0",
    "prettier": "^3.3.2",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3"
  },
  "prettier": "@acme/prettier-config"
}
